makeCMD('freeze', '/freeze', function(source, text)
    if freezeenabled then
        SendNotification('freeze already on', 'frreeze already on bro')
    else
        root = Player.Character:WaitForChild('HumanoidRootPart')
        freezeenabled = true
        freezepart = Instance.new('Part')
        freezepart.Position = root.Position
        freezepart.Transparency = 1
        freezepart.CanTouch = false
        while freezeenabled == true do
            root.CFrame = freezepart.CFrame
            wait(0.01)
        end
    end
end)
