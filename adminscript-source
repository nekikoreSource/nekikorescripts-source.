makeCMD('Tp2coords', '/TpUsingVector3', function(source, text)
    local coords = text:sub(17):split(' ')
    local x, y, z = tonumber(coords[1]), tonumber(coords[2]), tonumber(coords[3])
    if not (x and y and z) then
        SendNotification('error', 'use /TpUsingVector3 x y z')
        return
    end
    local tpbrick = Instance.new('Part')
    tpbrick.Position = Vector3.new(x, y, z)
    tpbrick.CanCollide = false
    Player.Character.HumanoidRootPart.CFrame = tpbrick.CFrame
    tpbrick:Destroy()
end)
