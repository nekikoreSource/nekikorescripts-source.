local function SendNotification(title, text)
    StarterGui:SetCore('SendNotification', { -- ooh setcore new!!
        Title = tostring(title),
        Text = tostring(text)
    })
end
local espEnabled = false
local espConnections = {}
local commands = {}
local function makeCMD(name, alias, callback) -- make sure it isnt function(makecmd())
    local command = Instance.new('TextChatCommand')
    SendNotification('LOADED COMMAND:', alias)
    cmds = cmds + 1
    command.Name = name
    command.PrimaryAlias = alias
    command.Triggered:Connect(callback)
    command.Parent = TextChatService
end

local function SendNotification(title, text)
    StarterGui:SetCore('SendNotification', { -- ooh setcore new!!
        Title = tostring(title),
        Text = tostring(text)
    })
end

local function addName(player)
    local function OnChar(character)
        local head = character:WaitForChild('Head')
        local billboard1 = Instance.new('BillboardGui') -- billboard for NameEsp (so i dont forget ofc)
        billboard1.Name = "NT"
        billboard1.Adornee = head
        billboard1.StudsOffset = Vector3.new(0, 2, 0) -- this is studs so its not 0.2
        billboard1.Size = UDim2.fromOffset(200, 50) -- btw for anyone wondering 1 is full screen
        billboard1.AlwaysOnTop = true -- "true", "false" aren't strings.
        billboard1.Parent = head

        local label = Instance.new('TextLabel')
        label.Size = UDim2.fromScale(1, 1)
        label.Text = player.Name
        label.BackgroundTransparency = 1 -- hide background
        label.TextColor3 = Color3.fromRGB(255, 255, 255) -- white text
        label.TextStrokeColor3 = Color3.fromRGB(0, 0, 0) -- black stroke
        label.TextStrokeTransparency = 0 -- fully visible
        label.TextScaled = true -- my friend told me to do this idk what this does pls tell me
        label.Parent = billboard1
    end

    if player.Character then
        OnChar(player.Character)
    end
    table.insert(espConnections, player.CharacterAdded:Connect(OnChar))
end

-- main code (do not copy)
local TP = Instance.new('TextChatCommand')
TP.Name = 'TP'
TP.PrimaryAlias = "/tp"
TP.Parent = TextChatService
table.insert(commands, TP)
TP.Triggered:Connect(function(OriginTextSource, UnFilteredText)
    local target = UnFilteredText:sub(5)
    local Target = Players:FindFirstChild(target)

    if not Target or not Target.Character then
        SendNotification('error', 'player not found')
        return
    end

    local root = Player.Character:WaitForChild('HumanoidRootPart')
    local targetRoot = Target.Character:WaitForChild("HumanoidRootPart")
    root.CFrame = targetRoot.CFrame
end)

makeCMD('nameesp', '/nameesp', function(source, text)
    if espEnabled == true then
        SendNotification('error', 'you already have ESP enabled.')
    else
        espEnabled = true
        for _, player in Players:GetPlayers() do
            addName(player)
        end
        table.insert(espConnections, Players.PlayerAdded:Connect(addName))
    end
end)

makeCMD('unnameesp', '/unnameesp', function(source, text)
    if not espEnabled then
        SendNotification('error', 'you have nameESP disabled. /nameesp to turn it on.')
    else
        espEnabled = false

        for _, connection in espConnections do
            connection:Disconnect()
        end
        table.clear(espConnections)

        for _, player in Players:GetPlayers() do
            if player.Character then
                local tag = player.Character:FindFirstChild('NT', true)
                if tag then
                    tag:Destroy()
                end
            end
        end
    end
end)
