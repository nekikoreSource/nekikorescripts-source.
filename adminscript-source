end)
makeCMD('executelua', '/executelua', function(source, text)
    local target_script = text:sub(13)
    local ok, err = pcall(function()
        local fn, compileError = loadstring(target_script)
        if not fn then
            error(compileError)
        end
        fn()
    end)
    if not ok then
        SendNotification('error', err)
    end
end)
