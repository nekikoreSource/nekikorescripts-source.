makeCMD('noclip', '/noclip', function(source, text)
    if noclipEnabled then
        SendNotification('error', 'noclip already active')
    else
        SendNotification('noclip', 'noclip is now on.')
        noclipEnabled = true
        noclipconnection = RunService.Stepped:Connect(function()
            local character = Player.Character
            if character then
                for _,part in character:GetDescendants() do
                    if part:IsA('BasePart') then
                        if noclipParts[part] == nil then
                            noclipParts[part] = part.CanCollide
                        end
                        part.CanCollide = false
                    end
                end
            end
        end)
    end
end)
makeCMD('unnoclip', '/unnoclip', function(source, text)
    if noclipEnabled == false then
        SendNotification('error','noclip already off.')
    else
        noclipEnabled = false
        noclipconnection:Disconnect()
        for part, original in noclipParts do
            if part.Parent then
                part.CanCollide = original
            end
        end
        table.clear(noclipParts)
    end
end)
